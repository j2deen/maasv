{
  "name": "@maev-ai/evolving-agents",
  "version": "0.1.0",
  "description": "MAEV — Memory Architecture for Evolving Agents. Currently ships the OpenClaw memory plugin: knowledge graph, multi-hop retrieval, lifecycle management, and experiential learning via a maev server.",
  "type": "module",
  "main": "index.ts",
  "license": "BSL-1.1",
  "author": "Adam Bell (original openclaw-maasv plugin)",
  "contributors": [
    "Jay Deen (MAEV continuation)"
  ],
  "keywords": [
    "openclaw",
    "memory",
    "plugin",
    "maev",
    "knowledge-graph",
    "cognition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j2deen/maev.git",
    "directory": "openclaw"
  },
  "homepage": "https://github.com/j2deen/maev/tree/main/openclaw#readme",
  "bugs": "https://github.com/j2deen/maev/issues",
  "files": [
    "index.ts",
    "client.ts",
    "types.ts",
    "tools/",
    "skill/",
    "openclaw.plugin.json",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "openclaw": "*",
    "typescript": "^5.5.0",
    "esbuild": "^0.24.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js",
    "prepublishOnly": "npm run build"
  }
}
